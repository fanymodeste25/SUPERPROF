# ==============================================
# Configuration de la Base de Données
# ==============================================

# DÉVELOPPEMENT LOCAL (SQLite - recommandé pour débuter)
# Simple, aucune installation requise
DATABASE_URL="file:./dev.db"

# PRODUCTION (PostgreSQL - pour déploiement)
# Décommentez et configurez cette ligne pour la production
# DATABASE_URL="postgresql://username:password@localhost:5432/superprof_db?schema=public"

# ==============================================
# NextAuth.js Configuration
# ==============================================

NEXTAUTH_URL="http://localhost:3000"

# Générez une clé secrète unique :
# Option 1: https://generate-secret.vercel.app/32
# Option 2: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-secret-key-here-change-this-in-production"

# ==============================================
# Stripe Configuration (Paiements)
# ==============================================
# Obtenez vos clés sur : https://dashboard.stripe.com/apikeys

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# ==============================================
# Configuration Email (optionnel)
# ==============================================

EMAIL_SERVER="smtp://username:password@smtp.example.com:587"
EMAIL_FROM="noreply@superprof.com"

# ==============================================
# Configuration de l'application
# ==============================================

NODE_ENV="development"
